; Engine configuration file.

config_version=5

[application]

config/name="FantasyPixelgame"
config/description="Rollenspiel im Pixelstil – Prototyp"
config/version="0.2.0"
run/main_scene="res://scenes/main.tscn"
config/icon="res://icon.svg"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

Game="*res://scripts/game.gd"
Fade="*res://scripts/ui/fade.gd"
Touch="*res://scripts/ui/touch_controls.gd"

[display]

window/size/viewport_width=384
window/size/viewport_height=216
window/size/window_width_override=1152
window/size/window_height_override=648
window/stretch/mode="viewport"
window/stretch/aspect="keep"
window/stretch/scale_mode="integer"
window/handheld/orientation=4

[gui]

theme/custom_font="res://assets/fonts/pixelfont.fnt"
theme/default_font_antialiasing=0
common/drop_mouse_on_gui_input_disabled=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.05, 0.05, 0.08, 1)
